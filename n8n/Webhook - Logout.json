    {
      "parameters": {
        "jsCode": "const filas = $input.all()\n  .map(item => item.json)\n  .filter(fila => Object.keys(fila).length > 0);\n\nif (filas.length > 1) {\n  throw new Error('Hay varias sesiones con la misma huella.');\n}\n\nconst sesion = filas[0] ?? null;\n\nif (!sesion) {\n  return [{\n    json: {\n      actualizar: false,\n      status_http: 401,\n      respuesta: {\n        ok: false,\n        error: {\n          codigo: 'SESION_INVALIDA',\n          mensaje: 'La sesión indicada no es válida.',\n        },\n      },\n    },\n  }];\n}\n\nconst huella = $('Preparar cierre de sesión').first().json.session_token;\n\nif (\n  !sesion.session_id ||\n  sesion.session_token !== huella ||\n  !['ACTIVA', 'CERRADA', 'EXPIRADA'].includes(sesion.estado)\n) {\n  throw new Error('El registro de sesión es inconsistente.');\n}\n\nconst expiracion = Date.parse(sesion.expira_en);\n\nif (!Number.isFinite(expiracion)) {\n  throw new Error('La sesión tiene una expiración inválida.');\n}\n\nconst ahora = new Date();\nconst actualizar = sesion.estado === 'ACTIVA';\n\n// Una sesión vencida se marca EXPIRADA.\n// Una sesión vigente se cierra por solicitud del usuario.\nconst estadoNuevo = actualizar\n  ? expiracion <= ahora.getTime() ? 'EXPIRADA' : 'CERRADA'\n  : sesion.estado;\n\nreturn [{\n  json: {\n    actualizar,\n    session_id: sesion.session_id,\n    estado: estadoNuevo,\n    cerrada_en: actualizar && estadoNuevo === 'CERRADA'\n      ? ahora.toISOString()\n      : sesion.cerrada_en || '',\n    status_http: 200,\n    respuesta: {\n      ok: true,\n      mensaje: 'La sesión ya no está activa.',\n    },\n  },\n}];"
      },
