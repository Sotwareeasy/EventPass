    {
      "parameters": {
        "jsCode": "const datos = $input.first().json;\n\nif (\n  datos.resultado !== 'PERMITIDO' ||\n  !datos.original ||\n  datos.evento_id !== datos.original.evento_id\n) {\n  throw new Error('El cambio de estado no superó la validación.');\n}\n\nconst ahora = new Date().toISOString();\n\nreturn [{\n  json: {\n    evento_id: datos.evento_id,\n    estado: datos.estado_nuevo,\n    fecha_actualizacion: ahora,\n\n    // Se escribirá únicamente después de actualizar el evento.\n    auditoria: {\n      auditoria_id: `AUD-ESTADO-${$execution.id}`,\n      evento_id: datos.evento_id,\n      accion: datos.accion,\n      fecha: ahora,\n      resultado: 'EXITO',\n      detalle: JSON.stringify({\n        estado_anterior: datos.estado_anterior,\n        estado_nuevo: datos.estado_nuevo,\n        motivo: datos.motivo,\n        origen: 'FORMULARIO_ADMINISTRATIVO',\n      }),\n    },\n  },\n}];"
      },
