    {
      "parameters": {
        "jsCode": "// Recuperamos la solicitud del formulario.\nconst solicitud = $('Formulario - Cambiar estado').first().json;\n\nfunction texto(valor) {\n  return typeof valor === 'string' ? valor.trim() : '';\n}\n\nconst eventoId = texto(solicitud.evento_id);\nconst accion = texto(solicitud.accion).toUpperCase();\nconst motivo = texto(solicitud.motivo);\nconst errores = [];\n\n// Excluimos únicamente el elemento vacío de una búsqueda sin resultados.\nconst filas = $input.all()\n  .map(item => item.json)\n  .filter(fila => Object.keys(fila).length > 0);\n\n// Relación entre acción solicitada y estado destino.\nconst destinos = new Map([\n  ['PUBLICAR', 'PUBLICADO'],\n  ['CERRAR', 'CERRADO'],\n  ['CANCELAR', 'CANCELADO'],\n]);\n\n// Transiciones permitidas para EventPass.\nconst transiciones = {\n  BORRADOR: ['PUBLICADO', 'CANCELADO'],\n  PUBLICADO: ['CERRADO', 'CANCELADO'],\n  CERRADO: ['CANCELADO'],\n  CANCELADO: [],\n};\n\nif (!eventoId) {\n  errores.push('El identificador del evento es obligatorio.');\n}\n\nif (!destinos.has(accion)) {\n  errores.push('La acción debe ser PUBLICAR, CERRAR o CANCELAR.');\n}\n\n// Regla de auditoría: un motivo breve, pero suficientemente explicativo.\nif (motivo.length < 10 || motivo.length > 500) {\n  errores.push('El motivo debe contener entre 10 y 500 caracteres.');\n}\n\nif (filas.length === 0) {\n  errores.push('No se encontró el evento solicitado.');\n} else if (filas.length > 1) {\n  errores.push('Hay varias filas con el mismo ID. Revisa los registros.');\n}\n\nconst original = filas.length === 1 ? filas[0] : null;\nconst estadoAnterior = original ? texto(original.estado) : null;\nconst estadoNuevo = destinos.get(accion) ?? null;\n\nlet resultado = 'RECHAZADO';\n\nif (original) {\n  if (texto(original.evento_id) !== eventoId) {\n    errores.push('El evento encontrado no coincide con el solicitado.');\n  }\n\n  if (\n    !['BORRADOR', 'PUBLICADO', 'CERRADO', 'CANCELADO']\n      .includes(estadoAnterior)\n  ) {\n    errores.push('El registro tiene un estado desconocido.');\n  }\n}\n\nif (errores.length === 0) {\n  if (estadoAnterior === estadoNuevo) {\n    // La acción ya fue realizada: no hay que repetir la escritura.\n    resultado = 'SIN_CAMBIOS';\n  } else if (!transiciones[estadoAnterior].includes(estadoNuevo)) {\n    errores.push(\n      `No se permite pasar de ${estadoAnterior} a ${estadoNuevo}.`\n    );\n  } else {\n    // Para publicar exigimos una fecha real y una hora futura.\n    if (accion === 'PUBLICAR') {\n      const fecha = texto(original.fecha);\n      const hora = texto(original.hora);\n\n      const fechaUTC = /^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)\n        ? new Date(`${fecha}T00:00:00.000Z`)\n        : new Date(NaN);\n\n      const fechaValida =\n        Number.isFinite(fechaUTC.getTime()) &&\n        fechaUTC.toISOString().slice(0, 10) === fecha;\n\n      const horaValida = /^([01]\\d|2[0-3]):[0-5]\\d$/.test(hora);\n\n      if (!fechaValida || !horaValida) {\n        errores.push('El evento tiene una fecha u hora inválida.');\n      } else {\n        const inicio = new Date(`${fecha}T${hora}:00-05:00`);\n\n        if (inicio.getTime() <= Date.now()) {\n          errores.push('Solo se pueden publicar eventos futuros.');\n        }\n      }\n\n      const capacidad = Number(original.capacidad);\n\n      if (!Number.isSafeInteger(capacidad) || capacidad <= 0) {\n        errores.push('El evento debe tener una capacidad entera positiva.');\n      }\n    }\n\n    if (errores.length === 0) {\n      resultado = 'PERMITIDO';\n    }\n  }\n}\n\nreturn [{\n  json: {\n    resultado,\n    errores,\n    evento_id: eventoId,\n    accion,\n    motivo,\n    estado_anterior: estadoAnterior,\n    estado_nuevo: estadoNuevo,\n    original,\n  },\n}];"
      },
