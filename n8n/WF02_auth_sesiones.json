    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst entrada = $input.first().json;\n\nif (entrada.autorizado !== true || !entrada.usuario?.usuario_id) {\n  throw new Error('No se puede crear una sesión sin autenticar al usuario.');\n}\n\nconst ahora = new Date();\nconst expiracion = new Date(ahora.getTime() + 8 * 60 * 60 * 1000);\n\n// Token de 256 bits generado con aleatoriedad criptográfica.\nconst token = `ep_${crypto.randomBytes(32).toString('base64url')}`;\n\n// Sheets almacenará esta huella, no el token utilizable.\nconst tokenHash = crypto\n  .createHash('sha256')\n  .update(token, 'utf8')\n  .digest('hex');\n\nconst sessionId = `SES-${crypto.randomBytes(16).toString('hex')}`;\n\nreturn [{\n  json: {\n    sesion: {\n      session_id: sessionId,\n      usuario_id: entrada.usuario.usuario_id,\n      session_token: `sha256:${tokenHash}`,\n      creada_en: ahora.toISOString(),\n      expira_en: expiracion.toISOString(),\n      estado: 'ACTIVA',\n      cerrada_en: '',\n      ultima_validacion: ahora.toISOString(),\n    },\n\n    // Se enviará únicamente después de guardar la sesión.\n    respuesta: {\n      ok: true,\n      data: {\n        usuario: entrada.usuario,\n        sesion: {\n          session_id: sessionId,\n          token,\n          token_type: 'Bearer',\n          expira_en: expiracion.toISOString(),\n        },\n      },\n    },\n  },\n}];"
      },
