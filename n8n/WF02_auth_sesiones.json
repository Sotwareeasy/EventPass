    {
      "parameters": {
        "jsCode": "const solicitud = $input.first().json;\nconst cuerpo = solicitud.body;\n\nconst contentType = String(\n  solicitud.headers?.['content-type'] ?? ''\n).split(';')[0].trim().toLowerCase();\n\nconst errores = [];\n\nconst esObjeto =\n  cuerpo !== null &&\n  typeof cuerpo === 'object' &&\n  !Array.isArray(cuerpo);\n\nconst datos = esObjeto ? cuerpo : {};\n\nif (!esObjeto) {\n  errores.push('El cuerpo debe ser un objeto JSON.');\n}\n\nif (Object.keys(datos).some(campo => !['email', 'password'].includes(campo))) {\n  errores.push('La solicitud contiene campos no permitidos.');\n}\n\nconst email = typeof datos.email === 'string'\n  ? datos.email.trim().toLowerCase()\n  : '';\n\nconst password = typeof datos.password === 'string'\n  ? datos.password\n  : '';\n\nif (\n  email.length > 254 ||\n  !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)\n) {\n  errores.push('Introduce una dirección de correo válida.');\n}\n\n// En login comprobamos que exista y tenga una longitud limitada.\n// La coincidencia con la contraseña registrada se comprueba después.\nconst longitud = Array.from(password).length;\n\nif (longitud === 0 || longitud > 128) {\n  errores.push('Introduce una contraseña de hasta 128 caracteres.');\n}\n\nlet statusHttp = errores.length > 0 ? 400 : 200;\n\nif (contentType !== 'application/json') {\n  statusHttp = 415;\n  errores.push('Envía el cuerpo con Content-Type application/json.');\n}\n\nreturn [{\n  json: {\n    valido: errores.length === 0,\n    status_http: statusHttp,\n    datos: errores.length === 0 ? {\n      email_normalizado: email,\n      password,\n    } : null,\n    respuesta: {\n      ok: false,\n      error: {\n        codigo: statusHttp === 415\n          ? 'FORMATO_NO_ADMITIDO'\n          : 'DATOS_INVALIDOS',\n        mensaje: 'Revisa la solicitud de inicio de sesión.',\n        detalles: errores,\n      },\n    },\n  },\n}];"
      },
