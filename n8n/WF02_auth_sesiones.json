    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst entrada = $('Validar entrada de login').first().json;\n\nif (entrada.valido !== true || !entrada.datos) {\n  throw new Error('La entrada del login no superó la validación.');\n}\n\nconst filas = $input.all()\n  .map(item => item.json)\n  .filter(fila => Object.keys(fila).length > 0);\n\nif (filas.length > 1) {\n  throw new Error('Hay varios usuarios con el mismo correo.');\n}\n\nconst usuario = filas[0] ?? null;\n\nconst parametros = {\n  N: 131072,\n  r: 8,\n  p: 1,\n  maxmem: 256 * 1024 * 1024,\n};\n\n// También hacemos un cálculo cuando el correo no existe.\n// Evitamos que esa ruta omita por completo el trabajo criptográfico.\nlet salt = crypto.randomBytes(16);\nlet hashEsperado = crypto.randomBytes(64);\n\nif (usuario) {\n  if (\n    !usuario.usuario_id ||\n    usuario.email_normalizado !== entrada.datos.email_normalizado\n  ) {\n    throw new Error('El registro de usuario es inconsistente.');\n  }\n\n  // Admitimos exactamente el formato que genera WF01.\n  // No ejecutamos parámetros arbitrarios tomados de Sheets.\n  const partes = String(usuario.password_hash ?? '').split('$');\n\n  const formatoValido =\n    partes.length === 6 &&\n    partes[0] === 'scrypt' &&\n    partes[1] === '131072' &&\n    partes[2] === '8' &&\n    partes[3] === '1' &&\n    partes[4] === '64' &&\n    /^[a-f0-9]{128}$/i.test(partes[5]) &&\n    /^[a-f0-9]{32}$/i.test(String(usuario.password_salt ?? ''));\n\n  if (!formatoValido) {\n    throw new Error('El registro tiene un formato de contraseña inválido.');\n  }\n\n  salt = Buffer.from(usuario.password_salt, 'hex');\n  hashEsperado = Buffer.from(partes[5], 'hex');\n}\n\nconst hashCalculado = crypto.scryptSync(\n  entrada.datos.password,\n  salt,\n  64,\n  parametros\n);\n\nconst coincide = crypto.timingSafeEqual(hashCalculado, hashEsperado);\n\nconst autorizado =\n  usuario !== null &&\n  coincide &&\n  usuario.estado === 'ACTIVO';\n\n// No devolvemos la contraseña ni los hashes.\nreturn [{\n  json: {\n    autorizado,\n    status_http: autorizado ? 200 : 401,\n    usuario: autorizado ? {\n      usuario_id: usuario.usuario_id,\n      nombre: usuario.nombre,\n      email: usuario.email_normalizado,\n    } : null,\n    respuesta: autorizado ? {\n      ok: true,\n      etapa: 'CREDENCIALES_VERIFICADAS',\n      mensaje: 'Credenciales correctas. Todavía no se ha creado una sesión.',\n    } : {\n      ok: false,\n      error: {\n        codigo: 'CREDENCIALES_INVALIDAS',\n        mensaje: 'No fue posible iniciar sesión con esas credenciales.',\n      },\n    },\n  },\n}];"
      },
