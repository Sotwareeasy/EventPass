    {
      "parameters": {
        "jsCode": "const solicitud = $input.first().json;\n\nconst encabezado = typeof solicitud.headers?.authorization === 'string'\n  ? solicitud.headers.authorization.trim()\n  : '';\n\n// Aceptamos el formato exacto del token generado por nuestro login.\nconst coincidencia = /^Bearer (ep_[A-Za-z0-9_-]{43})$/i.exec(encabezado);\n\nif (!coincidencia) {\n  return [{\n    json: {\n      continuar: false,\n      status_http: 401,\n      respuesta: {\n        ok: false,\n        error: {\n          codigo: 'SESION_INVALIDA',\n          mensaje: 'Inicia sesión para continuar.',\n        },\n      },\n    },\n  }];\n}\n\nconst crypto = require('crypto');\n\n// No cambiamos mayúsculas ni minúsculas del token.\nconst token = coincidencia[1];\n\nconst huella = crypto\n  .createHash('sha256')\n  .update(token, 'utf8')\n  .digest('hex');\n\nreturn [{\n  json: {\n    continuar: true,\n    session_token: `sha256:${huella}`,\n  },\n}];"
      },
