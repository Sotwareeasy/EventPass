    {
      "parameters": {
        "jsCode": "const sesion = $('Evaluar sesión').first().json.sesion;\n\nconst filas = $input.all()\n  .map(item => item.json)\n  .filter(fila => Object.keys(fila).length > 0);\n\nif (filas.length > 1) {\n  throw new Error('Se encontraron varios usuarios con el mismo ID.');\n}\n\nconst usuario = filas[0] ?? null;\n\n// Volvemos a comprobar la expiración después de consultar al usuario.\nconst valida =\n  usuario !== null &&\n  usuario.usuario_id === sesion.usuario_id &&\n  usuario.estado === 'ACTIVO' &&\n  Date.parse(sesion.expira_en) > Date.now();\n\nreturn [{\n  json: {\n    valida,\n    status_http: valida ? 200 : 401,\n    respuesta: valida ? {\n      ok: true,\n      data: {\n        usuario: {\n          usuario_id: usuario.usuario_id,\n          nombre: usuario.nombre,\n          email: usuario.email_normalizado,\n        },\n        sesion: {\n          session_id: sesion.session_id,\n          expira_en: sesion.expira_en,\n        },\n      },\n    } : {\n      ok: false,\n      error: {\n        codigo: 'SESION_INVALIDA',\n        mensaje: 'Inicia sesión para continuar.',\n      },\n    },\n  },\n}];"
      },
