    {
      "parameters": {
        "jsCode": "const autenticacion =\n  $('Autenticar consulta Telegram').first().json;\n\nconst usuarioId =\n  autenticacion.respuesta?.data?.usuario?.usuario_id;\n\nif (\n  autenticacion.status_http !== 200 ||\n  autenticacion.respuesta?.ok !== true ||\n  typeof usuarioId !== 'string' ||\n  !usuarioId\n) {\n  throw new Error('No hay un usuario autenticado válido.');\n}\n\nconst filas = $input.all()\n  .map(item => item.json)\n  .filter(fila => Object.keys(fila).length > 0);\n\nconst identificadores = new Set();\n\nfor (const fila of filas) {\n  if (\n    fila.usuario_id !== usuarioId ||\n    typeof fila.vinculacion_id !== 'string' ||\n    !fila.vinculacion_id.trim() ||\n    !['ACTIVA', 'INACTIVA'].includes(fila.estado)\n  ) {\n    throw new Error('La vinculación contiene datos inconsistentes.');\n  }\n\n  if (identificadores.has(fila.vinculacion_id)) {\n    throw new Error('Hay identificadores de vinculación duplicados.');\n  }\n\n  identificadores.add(fila.vinculacion_id);\n}\n\nconst activas = filas.filter(fila => fila.estado === 'ACTIVA');\n\nif (activas.length > 1) {\n  throw new Error('El usuario tiene varias vinculaciones activas.');\n}\n\nconst vinculacion = activas[0];\n\nif (\n  vinculacion &&\n  (\n    !/^[1-9]\\d*$/.test(String(vinculacion.chat_id)) ||\n    !Number.isFinite(Date.parse(vinculacion.fecha_vinculacion))\n  )\n) {\n  throw new Error('La vinculación activa está incompleta.');\n}\n\n// Devolvemos solo los datos que necesita la interfaz.\n// No exponemos el chat_id ni los códigos de vinculación.\nreturn [{\n  json: {\n    status_http: 200,\n    respuesta: {\n      ok: true,\n      data: {\n        telegram: {\n          vinculado: Boolean(vinculacion),\n          telegram_username: vinculacion\n            ? String(vinculacion.telegram_username ?? '')\n            : null,\n          fecha_vinculacion: vinculacion\n            ? vinculacion.fecha_vinculacion\n            : null,\n        },\n      },\n    },\n  },\n}];"
      },
