        "jsCode": "const rows=items=>items.map(i=>i.json).filter(r=>Object.entries(r).some(([k,v])=>k!=='row_number'&&v!==null&&v!==undefined&&String(v).trim()!==''));const x=$('Evaluar check-in').first().json;const rs=rows($input.all());if(rs.length!==1||rs[0].estado!=='ASISTIO'||rs[0].fecha_actualizacion!==x.fecha_checkin)throw Error('Asistencia no confirmada');for(const k of ['inscripcion_id','evento_id','usuario_id','nombre_acreditacion','observaciones','origen','orden_espera','fecha_inscripcion'])if(String(rs[0][k]??'')!==String(x.anterior[k]??''))throw Error('Campo protegido alterado');return [{json:x}];"
      },
      "onError": "continueErrorOutput"
    },
