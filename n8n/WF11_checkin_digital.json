CADO');\n  if(r.estado!=='CONFIRMADA')return reject(409,'CHECKIN_ESTADO_NO_PERMITIDO','Solo una inscripción confirmada permite registrar el ingreso.');\n  if(!['PUBLICADO','CERRADO'].includes(es[0].estado))return reject(409,'CHECKIN_EVENTO_NO_DISPONIBLE','Este evento no permite registrar ingresos.');\n  return {status:201,resultado:'EXITOSO',inscripcion:r,evento:es[0],respuesta:{ok:true,mensaje:'Check-in realizado correctamente.',data:{resultado:'EXITOSO',inscripcion_id:r.inscripcion_id,evento_id:r.evento_id,estado:'ASISTIO'}}};\n}\nconst rows=items=>items.map(i=>i.json).filter(r=>Object.entries(r).some(([k,v])=>k!=='row_number'&&v!==null&&v!==undefined&&String(v).trim()!==''));const x=$('Validar entrada').first().json;const d=evaluateCheckin(x.usuario_id,x.body,rows($('Leer inscripción').all()),rows($('Leer evento').all()),rows($input.all()));return [{json:{...x,continuar:d.resultado==='EXITOSO',status_http:d.status,respuesta:d.respuesta,anterior:d.inscripcion,registro:{checkin_id:x.checkin_id,inscripcion_id:x.inscripcion_id,evento_id:x.evento_id,usuario_id:x.usuario_id,fecha_checkin:x.fecha_checkin,resultado:d.resultado,detalle:JSON.stringify({codigo:d.respuesta.error?.codigo??'CHECKIN_OK',http:d.status})}}}];"
