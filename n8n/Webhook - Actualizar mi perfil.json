      "name": "Autenticar actualización de perfil",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const autenticacion = $input.first().json;\n\n// Una sesión inválida o un fallo técnico no permiten modificar datos.\nif (![200, 401, 503].includes(autenticacion.status_http)) {\n  throw new Error('La autenticación devolvió un resultado inesperado.');\n}\n\nif (autenticacion.status_http !== 200) {\n  return [{\n    json: {\n      actualizar: false,\n      status_http: autenticacion.status_http,\n      respuesta: autenticacion.respuesta,\n    },\n  }];\n}\n\nconst usuario = autenticacion.respuesta?.data?.usuario;\n\nif (autenticacion.respuesta?.ok !== true || !usuario?.usuario_id) {\n  throw new Error('No se obtuvo un usuario autenticado válido.');\n}\n\n// Recuperamos el cuerpo original, que no enviamos al subworkflow.\nconst solicitud = $('Webhook - Actualizar mi perfil').first().json;\n\nconst contentType = String(\n  solicitud.headers?.['content-type'] ?? ''\n).split(';')[0].trim().toLowerCase();\n\nconst cuerpo = solicitud.body;\n\nconst esObjeto =\n  cuerpo !== null &&\n  typeof cuerpo === 'object' &&\n  !Array.isArray(cuerpo);\n\nconst datos = esObjeto ? cuerpo : {};\nconst errores = [];\n\nif (!esObjeto) {\n  errores.push('El cuerpo debe ser un objeto JSON.');\n}\n\nif (Object.keys(datos).some(campo => campo !== 'nombre')) {\n  errores.push('Esta operación solo permite actualizar el nombre.');\n}\n\nconst nombre = typeof datos.nombre === 'string'\n  ? datos.nombre.trim()\n  : '';\n\nif (\n  nombre.length < 2 ||\n  nombre.length > 100 ||\n  /[\\u0000-\\u001f\\u007f]/.test(nombre)\n) {\n  errores.push('El nombre debe tener entre 2 y 100 caracteres válidos.');\n}\n\nif (contentType !== 'application/json') {\n  errores.push('Envía el cuerpo con Content-Type application/json.');\n}\n\nif (errores.length > 0) {\n  return [{\n    json: {\n      actualizar: false,\n      status_http: contentType !== 'application/json' ? 415 : 400,\n      respuesta: {\n        ok: false,\n        error: {\n          codigo: 'ACTUALIZACION_INVALIDA',\n          mensaje: 'Revisa los datos del perfil.',\n          detalles: errores,\n        },\n      },\n    },\n  }];\n}\n\nconst hayCambios = nombre !== usuario.nombre;\nconst ahora = new Date().toISOString();\n\nreturn [{\n  json: {\n    actualizar: hayCambios,\n    status_http: 200,\n\n    // El ID proviene de la sesión, nunca del cuerpo de la solicitud.\n    usuario_id: usuario.usuario_id,\n    nombre,\n    fecha_actualizacion: ahora,\n\n    auditoria: {\n      auditoria_id: `AUD-USR-UPDATE-${$execution.id}`,\n      usuario_id: usuario.usuario_id,\n      accion: 'UPDATE',\n      fecha: ahora,\n      resultado: 'EXITO',\n      detalle: JSON.stringify({\n        campo: 'nombre',\n        anterior: usuario.nombre,\n        nuevo: nombre,\n        origen: 'PERFIL_AUTENTICADO',\n      }),\n    },\n\n    respuesta: {\n      ok: true,\n      cambios_realizados: hayCambios,\n      data: {\n        usuario: {\n          usuario_id: usuario.usuario_id,\n          nombre,\n          email: usuario.email,\n          estado: 'ACTIVO',\n        },\n      },\n    },\n  },\n}];"
      },
