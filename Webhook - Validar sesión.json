    {
      "parameters": {
        "jsCode": "const filas = $input.all()\n  .map(item => item.json)\n  .filter(fila => Object.keys(fila).length > 0);\n\nif (filas.length > 1) {\n  throw new Error('Se encontraron varias sesiones con la misma huella.');\n}\n\nconst sesion = filas[0] ?? null;\nlet continuar = false;\nlet marcarExpirada = false;\n\nif (sesion) {\n  const huellaEsperada = $('Preparar validación de sesión')\n    .first().json.session_token;\n\n  if (\n    !sesion.session_id ||\n    !sesion.usuario_id ||\n    sesion.session_token !== huellaEsperada ||\n    !['ACTIVA', 'CERRADA', 'EXPIRADA'].includes(sesion.estado)\n  ) {\n    throw new Error('El registro de sesión es inconsistente.');\n  }\n\n  const expiracion = Date.parse(sesion.expira_en);\n\n  if (!Number.isFinite(expiracion)) {\n    throw new Error('La sesión tiene una fecha de expiración inválida.');\n  }\n\n  const vencida = expiracion <= Date.now();\n\n  // Solo marcamos las sesiones que todavía figuran como activas.\n  marcarExpirada =\n    sesion.estado === 'ACTIVA' &&\n    !sesion.cerrada_en &&\n    vencida;\n\n  continuar =\n    sesion.estado === 'ACTIVA' &&\n    !sesion.cerrada_en &&\n    !vencida;\n}\n\nreturn [{\n  json: {\n    continuar,\n    marcar_expirada: marcarExpirada,\n\n    // Se utiliza internamente para actualizar la fila.\n    session_id: sesion?.session_id ?? null,\n\n    // Solo las sesiones vigentes pasan a la consulta del usuario.\n    sesion: continuar ? sesion : null,\n\n    status_http: 401,\n    respuesta: {\n      ok: false,\n      error: {\n        codigo: 'SESION_INVALIDA',\n        mensaje: 'Inicia sesión para continuar.',\n      },\n    },\n  },\n}];"
      },
