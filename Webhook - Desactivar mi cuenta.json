    {
      "parameters": {
        "jsCode": "const autenticacion = $input.first().json;\n\nif (![200, 401, 503].includes(autenticacion.status_http)) {\n  throw new Error('La autenticación devolvió un resultado inesperado.');\n}\n\nif (autenticacion.status_http !== 200) {\n  return [{\n    json: {\n      desactivar: false,\n      status_http: autenticacion.status_http,\n      respuesta: autenticacion.respuesta,\n    },\n  }];\n}\n\nconst usuario = autenticacion.respuesta?.data?.usuario;\n\nif (autenticacion.respuesta?.ok !== true || !usuario?.usuario_id) {\n  throw new Error('No se obtuvo un usuario autenticado válido.');\n}\n\nconst solicitud = $('Webhook - Desactivar mi cuenta').first().json;\n\nconst contentType = String(\n  solicitud.headers?.['content-type'] ?? ''\n).split(';')[0].trim().toLowerCase();\n\nconst cuerpo = solicitud.body;\n\nconst confirmacionValida =\n  cuerpo !== null &&\n  typeof cuerpo === 'object' &&\n  !Array.isArray(cuerpo) &&\n  Object.keys(cuerpo).length === 1 &&\n  cuerpo.confirmacion === 'DESACTIVAR';\n\nif (contentType !== 'application/json' || !confirmacionValida) {\n  return [{\n    json: {\n      desactivar: false,\n      status_http: contentType !== 'application/json' ? 415 : 400,\n      respuesta: {\n        ok: false,\n        error: {\n          codigo: 'CONFIRMACION_INVALIDA',\n          mensaje: 'Envía un objeto JSON con confirmacion igual a DESACTIVAR.',\n        },\n      },\n    },\n  }];\n}\n\nconst ahora = new Date().toISOString();\n\nreturn [{\n  json: {\n    desactivar: true,\n    status_http: 200,\n\n    // La cuenta objetivo procede exclusivamente de la sesión.\n    usuario_id: usuario.usuario_id,\n    estado: 'INACTIVO',\n    fecha_actualizacion: ahora,\n\n    auditoria: {\n      auditoria_id: `AUD-USR-DEACTIVATE-${$execution.id}`,\n      usuario_id: usuario.usuario_id,\n      accion: 'DEACTIVATE',\n      fecha: ahora,\n      resultado: 'EXITO',\n      detalle: JSON.stringify({\n        estado_anterior: 'ACTIVO',\n        estado_nuevo: 'INACTIVO',\n        origen: 'PERFIL_AUTENTICADO',\n      }),\n    },\n\n    respuesta: {\n      ok: true,\n      mensaje: 'Tu cuenta fue desactivada.',\n    },\n  },\n}];"
      },
