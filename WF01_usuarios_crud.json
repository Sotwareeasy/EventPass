      "parameters": {
        "jsCode": "const validacion = $input.first().json;\n\nif (![200, 401, 503].includes(validacion.status_http)) {\n  throw new Error('La autenticación devolvió un resultado inesperado.');\n}\n\nif (validacion.status_http !== 200) {\n  return [{\n    json: {\n      status_http: validacion.status_http,\n      respuesta: validacion.respuesta,\n    },\n  }];\n}\n\nconst usuario = validacion.respuesta?.data?.usuario;\n\nif (\n  validacion.respuesta?.ok !== true ||\n  !usuario?.usuario_id\n) {\n  throw new Error('La autenticación no devolvió un usuario válido.');\n}\n\n// El subworkflow ya consultó al usuario y comprobó que está activo.\nreturn [{\n  json: {\n    status_http: 200,\n    respuesta: {\n      ok: true,\n      data: {\n        usuario: {\n          usuario_id: usuario.usuario_id,\n          nombre: usuario.nombre,\n          email: usuario.email,\n          estado: 'ACTIVO',\n        },\n      },\n    },\n  },\n}];"
