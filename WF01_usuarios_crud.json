      "parameters": {
        "jsCode": "const solicitud = $input.first().json;\nconst errores = [];\n\nconst contentType = String(\n  solicitud.headers?.['content-type'] ?? ''\n).split(';')[0].trim().toLowerCase();\n\nconst cuerpo = solicitud.body;\n\nconst esObjeto =\n  cuerpo !== null &&\n  typeof cuerpo === 'object' &&\n  !Array.isArray(cuerpo);\n\nconst datos = esObjeto ? cuerpo : {};\nlet statusHttp = 200;\n\nif (contentType !== 'application/json') {\n  statusHttp = 415;\n  errores.push('Envía el cuerpo con Content-Type application/json.');\n}\n\nif (!esObjeto) {\n  errores.push('El cuerpo debe ser un objeto JSON.');\n}\n\n// Solo aceptamos los campos previstos para el registro.\nconst camposPermitidos = ['nombre', 'email', 'password'];\n\nif (Object.keys(datos).some(campo => !camposPermitidos.includes(campo))) {\n  errores.push('La solicitud contiene campos no permitidos.');\n}\n\nconst nombre = typeof datos.nombre === 'string'\n  ? datos.nombre.trim()\n  : '';\n\nconst email = typeof datos.email === 'string'\n  ? datos.email.trim().toLowerCase()\n  : '';\n\n// La contraseña se conserva exactamente como fue enviada.\n// No eliminamos espacios ni cambiamos mayúsculas.\nconst password = typeof datos.password === 'string'\n  ? datos.password\n  : '';\n\nif (\n  nombre.length < 2 ||\n  nombre.length > 100 ||\n  /[\\u0000-\\u001f\\u007f]/.test(nombre)\n) {\n  errores.push('El nombre debe tener entre 2 y 100 caracteres válidos.');\n}\n\n// Validación básica de formato; no demuestra que el correo exista.\nif (\n  email.length > 254 ||\n  !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)\n) {\n  errores.push('Introduce una dirección de correo válida.');\n}\n\nconst longitudPassword = Array.from(password).length;\n\nif (longitudPassword < 15 || longitudPassword > 128) {\n  errores.push('La contraseña debe tener entre 15 y 128 caracteres.');\n}\n\nif (errores.length > 0 && statusHttp === 200) {\n  statusHttp = 400;\n}\n\nconst valido = errores.length === 0;\n\nreturn [{\n  json: {\n    valido,\n    errores,\n    status_http: statusHttp,\n\n    // Datos internos para el siguiente paso.\n    // Nunca devolveremos este objeto completo al cliente.\n    datos: valido ? {\n      nombre,\n      email_normalizado: email,\n      password,\n    } : null,\n\n    // Respuesta temporal de esta etapa: no confirma creación.\n    respuesta: valido ? {\n      ok: true,\n      etapa: 'VALIDACION',\n      mensaje: 'Datos válidos. El usuario todavía no se ha creado.',\n    } : {\n      ok: false,\n      error: {\n        codigo: statusHttp === 415\n          ? 'FORMATO_NO_ADMITIDO'\n          : 'DATOS_INVALIDOS',\n        mensaje: 'Revisa la solicitud de registro.',\n        detalles: errores,\n      },\n    },\n  },\n}];"
      },
