    {
      "parameters": {
        "jsCode": "const validacion = $('Validar registro de usuario').first().json;\n\nif (validacion.valido !== true || !validacion.datos) {\n  throw new Error('El registro no superó la validación.');\n}\n\nconst coincidencias = $input.all()\n  .map(item => item.json)\n  .filter(fila => Object.keys(fila).length > 0);\n\n// Cualquier coincidencia impide crear otra cuenta.\nif (coincidencias.length > 0) {\n  return [{\n    json: {\n      crear: false,\n      status_http: 409,\n      respuesta: {\n        ok: false,\n        error: {\n          codigo: 'CORREO_NO_DISPONIBLE',\n          mensaje: 'No se puede crear una cuenta con ese correo.',\n        },\n      },\n    },\n  }];\n}\n\nconst crypto = require('crypto');\nconst datos = validacion.datos;\n\nconst salt = crypto.randomBytes(16);\n\nconst parametros = {\n  N: 131072,\n  r: 8,\n  p: 1,\n  maxmem: 256 * 1024 * 1024,\n};\n\nconst hash = crypto.scryptSync(\n  datos.password,\n  salt,\n  64,\n  parametros\n);\n\nconst ahora = new Date().toISOString();\nconst usuarioId = `USR-${crypto.randomBytes(16).toString('hex')}`;\n\n// Guardamos algoritmo y parámetros junto al resultado.\n// El salt se guarda por separado, como exige el proyecto.\nconst passwordHash = [\n  'scrypt',\n  parametros.N,\n  parametros.r,\n  parametros.p,\n  64,\n  hash.toString('hex'),\n].join('$');\n\nconst usuario = {\n  usuario_id: usuarioId,\n  nombre: datos.nombre,\n  email_normalizado: datos.email_normalizado,\n  password_hash: passwordHash,\n  password_salt: salt.toString('hex'),\n  estado: 'ACTIVO',\n  fecha_registro: ahora,\n  fecha_actualizacion: ahora,\n};\n\n// La salida de este nodo ya no incluye la contraseña original.\nreturn [{\n  json: {\n    crear: true,\n    status_http: 201,\n    usuario,\n    auditoria: {\n      auditoria_id: `AUD-USR-CREATE-${$execution.id}`,\n      usuario_id: usuarioId,\n      accion: 'CREATE',\n      fecha: ahora,\n      resultado: 'EXITO',\n      detalle: 'Usuario creado mediante el endpoint de registro.',\n    },\n    respuesta: {\n      ok: true,\n      data: {\n        usuario: {\n          usuario_id: usuarioId,\n          nombre: usuario.nombre,\n          email: usuario.email_normalizado,\n          estado: usuario.estado,\n        },\n      },\n    },\n  },\n}];"
      },
