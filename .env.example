# Solo el servidor/proxy utiliza estas URLs. Nunca colocar secretos en VITE_*.
N8N_BASE_URL=http://127.0.0.1:5678
# En Vercel: URL HTTPS pública de n8n, sin /webhook al final.
# N8N_BASE_URL=https://tu-dominio-n8n.example
# URL de producción del Chat Trigger de WF10, cuando esté configurado.
N8N_CHAT_URL=
# Usuario público del bot (sin @), no su token.
VITE_TELEGRAM_BOT_USERNAME=
